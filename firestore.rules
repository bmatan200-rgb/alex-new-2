rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Keep direct Firestore access aligned with server.ts: only the verified
    // canonical Super Admin identity may use an admin claim for global reads.
    function isSuper() { return signedIn()
      && request.auth.token.role == 'super_admin'
      && request.auth.token.email == 'bmatan200@gmail.com'
      && request.auth.token.email_verified == true; }
    function active(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)).data.status in ['active','trial']; }
    function isBusinessAdmin(tenantId) {
      return signedIn() && request.auth.token.role == 'business_admin'
        && request.auth.token.tenantId == tenantId && active(tenantId)
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerAuthUid == request.auth.uid
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.disabled == false;
    }
    function canManage(tenantId) { return isSuper() || isBusinessAdmin(tenantId); }
    function isValidId(id) { return id is string && id.size() <= 256; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'currentPrice', 'userId'])
        && data.name is string && data.name.size() <= 200
        && data.currentPrice is number && data.userId == request.auth.uid;
    }
    function isValidInvoice(data) {
      return data.keys().hasAll(['userId', 'items']) && data.userId == request.auth.uid
        && data.items is list && data.items.size() <= 500;
    }

    // All mutations pass through server validation and transactions.
    match /domains/{hostname} { allow read, write: if false; }
    match /tenants/{tenantId} {
      allow read: if canManage(tenantId);
      allow write: if false;
      match /settings/{docId} {
        allow read: if (docId == 'config' && active(tenantId)) || canManage(tenantId);
        allow write: if false;
      }
      match /customers/{id} { allow read: if canManage(tenantId); allow write: if false; }
      match /appointments/{id} { allow read: if canManage(tenantId); allow write: if false; }
      match /sms_logs/{id} { allow read: if canManage(tenantId); allow write: if false; }
      match /reminder_locks/{id} { allow read, write: if false; }
      match /private_settings/{id} { allow read, write: if false; }
      match /booking_days/{id} { allow read, write: if false; }
    }

    match /adminUsers/{uid} { allow read, write: if false; }

    match /products/{productId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && isValidProduct(request.resource.data) && isValidId(productId);
      allow update: if isOwner(resource.data.userId) && isValidProduct(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
      match /history/{historyId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/products/$(productId)).data.userId);
      }
    }
    match /invoices/{invoiceId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && isValidInvoice(request.resource.data) && isValidId(invoiceId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /appointments/{id} { allow read, write: if false; }
    match /settings/{id} { allow read, write: if false; }
    match /customers/{id} { allow read, write: if false; }
    match /reminder_locks/{id} { allow read, write: if false; }
    match /sms_logs/{id} { allow read, write: if false; }
    match /whatsapp_logs/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
