{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Multi-tenant business profile, branding, and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique tenant slug identifier" },
        "name": { "type": "string", "description": "Business brand name" },
        "tagline": { "type": "string", "description": "Business tagline or description" },
        "ownerName": { "type": "string", "description": "Owner full name" },
        "phone": { "type": "string", "description": "Business phone number" },
        "email": { "type": "string", "description": "Business email address" },
        "city": { "type": "string", "description": "City" },
        "address": { "type": "string", "description": "Physical address" },
        "primaryColor": { "type": "string", "description": "Hex branding color" },
        "customDomain": { "type": "string", "description": "Custom mapped hostname" },
        "status": { "type": "string", "enum": ["active", "trial", "suspended"] },
        "plan": { "type": "string", "enum": ["starter", "pro", "enterprise"] },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "name", "phone", "ownerName"]
    },
    "DomainMapping": {
      "title": "DomainMapping",
      "description": "Mapping from custom domain hostname to tenantId",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string", "description": "Target tenant identifier" },
        "hostname": { "type": "string", "description": "Domain hostname (e.g. salon.example.com)" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["tenantId"]
    },
    "TenantConfig": {
      "title": "TenantConfig",
      "description": "Services, working hours, and reminder configurations per tenant",
      "type": "object",
      "properties": {
        "services": { "type": "array", "description": "List of salon services" },
        "scheduleSettings": { "type": "object", "description": "Business open/close and duration settings" },
        "salonInfo": { "type": "object", "description": "General salon info and hours" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      }
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled appointment for salon services",
      "type": "object",
      "properties": {
        "customer_name": { "type": "string" },
        "customer_phone": { "type": "string" },
        "customer_email": { "type": "string" },
        "service_name": { "type": "string" },
        "price": { "type": "number" },
        "appointment_date": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "cancelled"] },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["customer_name", "customer_phone", "appointment_date", "start_time", "end_time", "status"]
    }
  },
  "firestore": {
    "/domains/{hostname}": {
      "entity": "DomainMapping",
      "description": "Domain to tenant resolution mapping"
    },
    "/tenants/{tenantId}": {
      "entity": "Tenant",
      "description": "Tenant profile and branding information"
    },
    "/tenants/{tenantId}/settings/config": {
      "entity": "TenantConfig",
      "description": "Tenant services, schedule settings, and configurations"
    },
    "/tenants/{tenantId}/appointments/{appointmentId}": {
      "entity": "Appointment",
      "description": "Appointments booked for the specific tenant"
    }
  }
}
