# Telnyx SMS Integration
TELNYX_API_KEY=
TELNYX_PROFILE_ID=
TELNYX_FROM=

# Firebase Admin Service Account (JSON string)
FIREBASE_SERVICE_ACCOUNT=

# Compatibility setting retained for existing Render environments.
# V26 enforces exactly one canonical Super Admin in server.ts: bmatan200@gmail.com.
SUPER_ADMIN_EMAILS=bmatan200@gmail.com

# Optional override. By default server uses firebase-applet-config.json firestoreDatabaseId.
FIRESTORE_DATABASE_ID=ai-studio-alex-0ace37ff-f441-4c64-bdb6-3ba856e2147c

# Production host settings
NODE_ENV=production
PORT=3000
# Keep false during migration, then enable after rules/config verification.
SMS_SCHEDULER_ENABLED=false
# Set false to stop every automated, manual, batch, and test SMS path during deployment.
SMS_SENDING_ENABLED=true
# Central SaaS SMS provider is shared with all tenants by default. Set false only to require per-tenant provider credentials.
ALLOW_SHARED_SMS_PROVIDER=true
# Only after comparing old deleted/missing appointments with a backup.
IMPORT_MISSING_LEGACY_APPOINTMENTS=false

# v18 quota protection (optional; defaults shown)
# V39: idle heartbeat queries only due schedules; backlog drains in bounded batches.
SMS_SCHEDULER_INTERVAL_MS=60000
# V41: paced starts per process (50ms = up to 20 requests/s), including manual sends.
# Increase throughput only after verifying Telnyx/account/number limits.
SMS_SEND_INTERVAL_MS=50
SMS_SEND_CONCURRENCY=20
# Stop repeated Firestore attempts for 15 minutes after RESOURCE_EXHAUSTED.
FIRESTORE_QUOTA_BACKOFF_MS=900000
# Cache appointment snapshots server-side for 10 minutes; mutations invalidate immediately.
APPOINTMENTS_CACHE_TTL_MS=600000
# Cache tenant profile (5m) / Super Admin tenant list (2m); mutations invalidate relevant caches.
TENANT_CACHE_TTL_MS=300000
SUPER_ADMIN_CACHE_TTL_MS=120000

# Secure external Cron heartbeat. Use a random secret of at least 24 characters.
# Preferred auth: x-cron-secret header. Fallback: ?key=<CRON_SECRET>.
CRON_SECRET=
