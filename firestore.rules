rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appointments/{appointmentId} {
      // Allow reading booked slots so the app can display availability & let customers look up their bookings
      allow read: if true;

      // Allow creating an appointment with valid fields
      allow create: if request.resource.data.customer_name is string
                    && request.resource.data.customer_name.size() > 0
                    && request.resource.data.customer_phone is string
                    && request.resource.data.customer_phone.size() > 0
                    && request.resource.data.appointment_date is string
                    && request.resource.data.start_time is string
                    && request.resource.data.end_time is string
                    && request.resource.data.status in ['confirmed', 'cancelled'];

      // Allow updating appointment status (cancellations)
      allow update: if true;

      // Allow salon admin to remove appointments
      allow delete: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
