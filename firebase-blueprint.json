{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled appointment for nail salon services",
      "type": "object",
      "properties": {
        "customer_name": {
          "type": "string",
          "description": "Full name of the client",
          "minLength": 2,
          "maxLength": 100
        },
        "customer_phone": {
          "type": "string",
          "description": "Phone number of the client",
          "minLength": 8,
          "maxLength": 20
        },
        "customer_email": {
          "type": "string",
          "description": "Email address of the client (optional)"
        },
        "service_id": {
          "type": "number",
          "description": "Numeric ID of the service"
        },
        "service_name": {
          "type": "string",
          "description": "Name of the booked service"
        },
        "price": {
          "type": "number",
          "description": "Service price in ILS"
        },
        "appointment_date": {
          "type": "string",
          "description": "Appointment date in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "start_time": {
          "type": "string",
          "description": "Start time in HH:mm format",
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "end_time": {
          "type": "string",
          "description": "End time in HH:mm format",
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"],
          "description": "Current status of appointment"
        },
        "notes": {
          "type": "string",
          "description": "Customer notes or requests"
        },
        "created_at": {
          "type": "string",
          "description": "ISO timestamp when the appointment was created"
        }
      },
      "required": ["customer_name", "customer_phone", "appointment_date", "start_time", "end_time", "status"]
    },
    "ServicesConfig": {
      "title": "ServicesConfig",
      "description": "Salon services configuration list",
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "description": "List of salon services"
        }
      }
    },
    "ScheduleSettings": {
      "title": "ScheduleSettings",
      "description": "Salon opening hours and duration settings",
      "type": "object",
      "properties": {
        "businessOpen": { "type": "string" },
        "businessClose": { "type": "string" },
        "fridayOpen": { "type": "string" },
        "fridayClose": { "type": "string" },
        "durationMinutes": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of all booked and cancelled appointments"
    },
    "/settings/{docId}": {
      "schema": "ServicesConfig",
      "description": "Salon settings and configurations"
    }
  }
}
