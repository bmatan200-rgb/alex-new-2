# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP AUTOMATION SETTINGS (Optional - for 100% hands-free automatic 8:00 AM dispatch)
# Provider options: greenapi | ultramsg | twilio | webhook
WHATSAPP_PROVIDER="greenapi"

# Green API (QR code connection to Alex's existing WhatsApp 054-6307114)
GREEN_API_INSTANCE_ID=""
GREEN_API_TOKEN=""

# UltraMsg (Alternative QR WhatsApp gateway)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""

# Twilio (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_TYPE="sms"

# Custom Webhook (Make.com / Zapier webhook for sending WhatsApp)
WHATSAPP_WEBHOOK_URL=""

# Target morning hour for automated same-day reminders (default: 8 for 08:00 AM)
REMINDER_MORNING_HOUR="8"

# LIVE_PRODUCTION_MODE
# Set to 'true' in your LIVE PRODUCTION environment.
# When false or empty (like in local dev), WhatsApp messages and webhooks will run in a "dry-run" simulation mode (logged to console) to prevent dev interference.
LIVE_PRODUCTION_MODE="false"
VITE_LIVE_PRODUCTION_MODE="false"

# Registration Webhook for Twilio / WhatsApp / SMS Automation
REGISTRATION_WEBHOOK_URL=""

# Internal API Secret for protecting server endpoints (Webhook/Cron)
INTERNAL_API_SECRET="alex_sec_9f7c2b4e8a1d5c0e7b2a6f4d3c8e1b9a2d5f7e0c4b6a8d1e3f5a7c9b0e2d4f6"

# Secret used to secure the external cron job endpoint (/api/whatsapp/cron-trigger)
CRON_SECRET="your_secure_cron_secret_here"
