rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.token.role == 'super_admin'; }
    function isBusinessAdmin(tenantId) {
      return signedIn() && request.auth.token.role == 'business_admin' && request.auth.token.tenantId == tenantId;
    }
    function canManage(tenantId) { return isSuper() || isBusinessAdmin(tenantId); }
    function isValidId(id) { return id is string && id.size() <= 256; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'currentPrice', 'userId'])
        && data.name is string && data.name.size() <= 200
        && data.currentPrice is number && data.userId == request.auth.uid;
    }
    function isValidInvoice(data) {
      return data.keys().hasAll(['userId', 'items']) && data.userId == request.auth.uid
        && data.items is list && data.items.size() <= 500;
    }

    match /domains/{hostname} { allow read: if true; allow write: if isSuper(); }
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isSuper();
      match /settings/{docId} { allow read: if true; allow write: if canManage(tenantId); }
      match /customers/{customerId} { allow read, write: if canManage(tenantId); }
      match /appointments/{appointmentId} {
        allow read: if true;
        allow create: if request.resource.data.customer_name is string
          && request.resource.data.customer_name.size() > 0
          && request.resource.data.customer_name.size() <= 100
          && request.resource.data.customer_phone is string
          && request.resource.data.customer_phone.size() >= 7
          && request.resource.data.customer_phone.size() <= 25
          && request.resource.data.appointment_date is string
          && request.resource.data.start_time is string
          && request.resource.data.end_time is string
          && request.resource.data.status in ['confirmed', 'cancelled'];
        allow update, delete: if canManage(tenantId);
      }
      match /reminder_locks/{id} { allow read, write: if canManage(tenantId); }
      match /sms_logs/{id} { allow read, write: if canManage(tenantId); }
      match /whatsapp_logs/{id} { allow read, write: if canManage(tenantId); }
    }

    match /adminUsers/{uid} { allow read, write: if false; }

    match /products/{productId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && isValidProduct(request.resource.data) && isValidId(productId);
      allow update: if isOwner(resource.data.userId) && isValidProduct(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
      match /history/{historyId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/products/$(productId)).data.userId);
      }
    }
    match /invoices/{invoiceId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && isValidInvoice(request.resource.data) && isValidId(invoiceId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /appointments/{id} { allow read, write: if false; }
    match /settings/{id} { allow read, write: if false; }
    match /customers/{id} { allow read, write: if false; }
    match /reminder_locks/{id} { allow read, write: if false; }
    match /sms_logs/{id} { allow read, write: if false; }
    match /whatsapp_logs/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
