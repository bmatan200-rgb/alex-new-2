{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled appointment for nail salon services",
      "type": "object",
      "properties": {
        "customer_name": {
          "type": "string",
          "description": "Full name of the client"
        },
        "customer_phone": {
          "type": "string",
          "description": "Phone number of the client"
        },
        "customer_email": {
          "type": "string",
          "description": "Email address of the client (optional)"
        },
        "service_name": {
          "type": "string",
          "description": "Name of the booked service"
        },
        "price": {
          "type": "number",
          "description": "Service price in ILS"
        },
        "appointment_date": {
          "type": "string",
          "description": "Appointment date in YYYY-MM-DD format"
        },
        "start_time": {
          "type": "string",
          "description": "Start time in HH:mm format"
        },
        "end_time": {
          "type": "string",
          "description": "End time in HH:mm format"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"],
          "description": "Current status of appointment"
        },
        "notes": {
          "type": "string",
          "description": "Customer notes or requests"
        },
        "created_at": {
          "type": "string",
          "description": "ISO timestamp when the appointment was created"
        }
      },
      "required": ["customer_name", "customer_phone", "appointment_date", "start_time", "end_time", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Manager and administrator credentials synced via Firebase",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Admin username or full name"
        },
        "phone": {
          "type": "string",
          "description": "Admin phone number"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address"
        },
        "password": {
          "type": "string",
          "description": "Password or authentication secret"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "owner", "staff"],
          "description": "Administrative role"
        },
        "created_at": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "last_login_at": {
          "type": "string",
          "description": "Last successful login timestamp"
        }
      },
      "required": ["username", "phone", "email", "password"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered customer records in the directory",
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the customer"
        },
        "created_at": {
          "type": "string",
          "description": "Registration timestamp"
        },
        "last_login_at": {
          "type": "string",
          "description": "Last activity or login timestamp"
        },
        "notes": {
          "type": "string",
          "description": "Customer notes or preferences"
        }
      },
      "required": ["full_name", "phone", "created_at", "last_login_at"]
    },
    "SmsLogEntry": {
      "title": "SmsLogEntry",
      "description": "Audit log entry for automated and manual SMS reminders",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Log record identifier"
        },
        "recipientName": {
          "type": "string",
          "description": "Name of the recipient"
        },
        "recipientPhone": {
          "type": "string",
          "description": "Phone number formatted with country code"
        },
        "messageText": {
          "type": "string",
          "description": "Content of the sent message"
        },
        "status": {
          "type": "string",
          "enum": ["sent", "failed"],
          "description": "Delivery dispatch status"
        },
        "sentAt": {
          "type": "string",
          "description": "ISO timestamp of dispatch"
        }
      },
      "required": ["id", "recipientName", "recipientPhone", "messageText", "status", "sentAt"]
    },
    "ReminderLock": {
      "title": "ReminderLock",
      "description": "Deduplication lock to ensure exactly-once automated reminder delivery",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Unique key per appointment and reminder window"
        },
        "claimedAt": {
          "type": "string",
          "description": "Timestamp when lock was claimed"
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "sent"],
          "description": "Lock execution state"
        }
      },
      "required": ["key", "claimedAt"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "entity": "Appointment",
      "description": "Collection of all booked and cancelled appointments"
    },
    "/admin_users/{adminId}": {
      "entity": "AdminUser",
      "description": "Collection of synced admin users with username, phone, email, and password"
    },
    "/customers/{customerId}": {
      "entity": "Customer",
      "description": "Directory of registered customers with phone, name, and activity timestamps"
    },
    "/sms_logs/{logId}": {
      "entity": "SmsLogEntry",
      "description": "Audit log collection for sent SMS reminders"
    },
    "/reminder_locks/{lockId}": {
      "entity": "ReminderLock",
      "description": "Locks collection preventing duplicate automatic reminder dispatches"
    }
  }
}
