rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /appointments/{appointmentId} {
      allow read: if true;

      allow create: if request.resource.data.customer_name is string
                    && request.resource.data.customer_name.size() > 0
                    && request.resource.data.customer_name.size() <= 100
                    && request.resource.data.customer_phone is string
                    && request.resource.data.customer_phone.size() >= 9
                    && request.resource.data.customer_phone.size() <= 20
                    && request.resource.data.appointment_date is string
                    && request.resource.data.appointment_date.matches('^\\d{4}-\\d{2}-\\d{2}$')
                    && request.resource.data.start_time is string
                    && request.resource.data.start_time.matches('^\\d{2}:\\d{2}$')
                    && request.resource.data.end_time is string
                    && request.resource.data.status in ['confirmed', 'cancelled'];

      allow update: if request.resource.data.status in ['confirmed', 'cancelled'];
      allow delete: if true;
    }

    match /settings/{docId} {
      allow read: if docId != 'admin_users';
      allow write: if docId in ['services_config', 'schedule_settings'];
    }

    match /reminder_locks/{lockId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /whatsapp_logs/{logId} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
